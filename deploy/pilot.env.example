PILOT_DOMAIN=pilot.example.org
PILOT_API_PORT=8080
PUBLIC_ORIGINS=https://pilot.example.org
COOKIE_SECURE=true
APP_PORT=8080
MAX_SESSIONS=2
SESSION_TTL_SECONDS=1800
SESSION_IDLE_SECONDS=600
SESSION_WARNING_SECONDS=120
SESSION_MONITOR_SECONDS=2
SESSION_ROS_DOMAIN_ID=42
SESSION_READ_ONLY=true
SESSION_APPARMOR=docker-default
HOST_RUN_DIR=/srv/launchpad/run/sessions
DOCKER_SOCKET=/run/user/1000/docker.sock
RUNTIME_TOKEN=change-me
PILOT_TRUST_FORWARDED=true
PILOT_INVITE_TTL_SECONDS=7200
PILOT_ACCESS_TTL_SECONDS=7200
PILOT_RATE_LIMIT=6
PILOT_RATE_WINDOW_SECONDS=900
