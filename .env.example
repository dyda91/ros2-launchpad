APP_PORT=8080
RUNTIME_TOKEN=dev-local-runtime-token
HOST_RUN_DIR=/home/pc/ros2-launchpad/run/sessions
MAX_SESSIONS=2

SESSION_TTL_SECONDS=1800
SESSION_IDLE_SECONDS=600
SESSION_WARNING_SECONDS=120
SESSION_MONITOR_SECONDS=2
SESSION_ROS_DOMAIN_ID=42
COOKIE_SECURE=false
DOCKER_SOCKET=/var/run/docker.sock
SESSION_READ_ONLY=false
SESSION_APPARMOR=
SESSION_TMPFS_SIZE=256m
SESSION_ULIMIT_NOFILE=4096
SESSION_ULIMIT_CORE_MB=0
SESSION_ULIMIT_FSIZE_MB=64
